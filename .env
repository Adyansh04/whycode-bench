# Environment variables for docker-compose

# Compose project name shown by `docker compose ps`
COMPOSE_PROJECT_NAME=whycode_bench

# ROS distribution (jazzy, humble, iron, etc.)
ROS_DISTRO=jazzy

# Upstream base image: <BASE_IMAGE_REPO>:<ROS_DISTRO><BASE_IMAGE_TAG_SUFFIX>
BASE_IMAGE_REPO=adyansh04/ros-dev
BASE_IMAGE_TAG_SUFFIX=-latest

# Derived dev image built from .devcontainer/Dockerfile
DEV_IMAGE_REPO=adyansh04/ros-dev-workspace

# Container naming prefix: <CONTAINER_PREFIX>_<ROS_DISTRO>
CONTAINER_PREFIX=whycode_dev

# Display for GUI applications (usually inherited from host)
# DISPLAY=:0

# --- Isaac Sim ---
# Version pin. 5.1 through 6.2 are all Ubuntu 24.04 / Python 3.12, so switching
# between them needs no other change.
ISAAC_SIM_VERSION=6.2.0.1

# Viewport mode: 1 = headless (cheapest, use for recording)
#                0 = WebRTC livestream at http://localhost:8211/streaming/webrtc-client
#                x11 = native GUI through the mounted X11 socket
ISAAC_HEADLESS=1

# Scene layout the simulation loads on start.
SCENE_CONFIG=/root/workspace/src/whycode_sim/whycode_sim/config/scene.yaml

# Must match between ros-dev and isaac for DDS discovery. The base image bakes a
# different value, so both services take it from here explicitly.
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
